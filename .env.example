# ─────────────────────────────────────────────────────────────
#  personal-pi-home — secrets
#
#  cp .env.example .env  and fill in what you actually want.
#  `.env` is gitignored. Everything that isn't a secret belongs in
#  hub/config.yaml instead, which IS committed.
#
#  You can leave this entire file blank. The hub runs, every job works,
#  and messages go to the log instead of your phone. Wire up one channel
#  when you want it to reach you — check what's live at any point with:
#
#      cd hub && python -m src.main --doctor
# ─────────────────────────────────────────────────────────────


# ══ Notification channels ══════════════════════════════════════
# Pick at least one. Which jobs use which is set in hub/config.yaml
# → notify. Full walkthroughs: docs/NOTIFIERS.md

# ── ntfy — no account, no token, ~2 minutes ────────────────────
# Install the ntfy app, subscribe to a topic you invent, put it here.
# Anyone who knows the topic name can read your notifications on the
# public server, so make it unguessable — it IS the credential.
NTFY_TOPIC=
# Only if you self-host ntfy:
NTFY_SERVER=
NTFY_TOKEN=

# ── Telegram — a bot token and your chat id ────────────────────
# Message @BotFather → /newbot → copy the token. Then message your new
# bot once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
# Comma-separated: you, your partner, a group chat…
TELEGRAM_CHAT_IDS=

# ── Discord — one webhook URL, nothing else ────────────────────
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=

# ── Email — for anything you'll want to search again later ─────
# Gmail needs an APP PASSWORD, not your login password: turn on 2-Step
# Verification, then create one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true          # false for implicit TLS on port 465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=                  # blank = same as SMTP_USER
MAIL_TO=                    # comma-separated recipients

# ── LINE — only if you already have a LINE Official Account ────
# Skip this unless you've already got one; setting up a Messaging API
# channel is a chore, and any option above is easier. See docs/NOTIFIERS.md
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_IDS=


# ══ Optional ═══════════════════════════════════════════════════

# Overrides hub/config.yaml → timezone. Every schedule is local wall-clock
# time in this zone, whatever the host clock says.
HUB_TIMEZONE=

# The container's own clock (used by log timestamps).
TZ=UTC

# Days of rotating DEBUG logs to keep. Default 14.
LOG_RETENTION_DAYS=14
